# バックエンドAPI URL（開発時はSpring Bootのポート）
VITE_API_BASE_URL=http://localhost:8080

# LINE LIFF ID（ユーザー向けミニアプリ）
VITE_LIFF_ID=your-liff-id-here

# LINE LIFF ID（管理者向けミニアプリ）
VITE_ADMIN_LIFF_ID=your-admin-liff-id-here

# 開発用モック認証（true にするとLIFF/バックエンド認証をスキップ）
# 本番デプロイ前に必ず false または削除すること
VITE_DEV_MOCK_AUTH=true

# モック時の管理者モード（true = 管理者画面で開く）
VITE_DEV_MOCK_ADMIN=false
